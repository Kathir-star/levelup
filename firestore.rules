rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {userId} (matches request.auth.uid)
    // Fields:
    //   - uid: string (required, matches userId)
    //   - email: string (optional)
    //   - displayName: string (optional)
    //   - schemaVersion: number (required)
    //   - updatedAt: string (required)
    //   - profile: map (optional)
    //   - workoutData: map (optional)
    //   - prs: map (optional)
    //   - steps: number (optional)
    //   - stepsHistory: map (optional)
    //   - water: number (optional)
    //   - waterHistory: map (optional)
    //   - sleepData: list (optional)
    //   - missions: list (optional)
    //   - nutritionLogs: map (optional)
    //   - customFoods: list (optional)
    //   - savedMeals: list (optional)
    //   - bodyMetricsHistory: list (optional)
    //   - selfMastery: map (optional)
    //   - plannerSchedule: map (optional)
    //   - winterArc: map (optional)
    //   - settings: map (optional)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserVault(userId) {
      return request.resource.data.keys().hasAll(['uid', 'schemaVersion', 'updatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.uid == userId
        && request.resource.data.schemaVersion is number
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 64;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserVault(userId);
      allow update: if isOwner(userId) && isValidUserVault(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }
  }
}
